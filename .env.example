# ICM Teacher Workspace — environment variables (docs/plans/icm-workspace-plan/01 step 5)
# Dev: copy to .env.local and fill in. Prod: set in Vercel → Project → Settings
# → Environment Variables (use the PROD GitHub App's credentials — dev and prod
# are separate GitHub Apps, 01 step 3). All 9 ICM vars are required at runtime;
# src/lib/session.ts#requireEnv throws on any that are missing.

# --- GitHub App (separate apps for dev and prod) ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=                # url-name of the app, for /apps/<slug>/installations/new
GITHUB_APP_PRIVATE_KEY=         # .pem contents, base64-encoded (single line): base64 -w0 app.private-key.pem
GITHUB_CLIENT_ID=               # the GitHub App's client id (OAuth web flow)
GITHUB_CLIENT_SECRET=           # the GitHub App's client secret

# --- Session ---
SESSION_SECRET=                 # 32-byte random hex: openssl rand -hex 32

# --- LLM ---
AI_GATEWAY_API_KEY=             # Vercel dashboard → AI Gateway (default "AI on us" provider)

# --- Repo provisioning ---
TEMPLATE_REPO=                  # <ngo-org>/icm-teacher-workspace-template (must be a "Template repository")
APP_URL=http://localhost:3000   # https://<prod-domain> in prod — OAuth callback/setup URLs derive from it

# --- ImageKit (pre-existing site media; unrelated to the workspace) ---
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
